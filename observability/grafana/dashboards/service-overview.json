{
  "uid": "incident-services", "title": "Incident Copilot — Service Overview", "schemaVersion": 39,
  "refresh": "10s", "time": {"from": "now-30m", "to": "now"},
  "panels": [
    {"id": 1, "type": "timeseries", "title": "HTTP request rate", "datasource": {"uid": "prometheus"},
     "targets": [{"expr": "sum by (application, uri) (rate(http_server_requests_seconds_count[1m]))", "legendFormat": "{{application}} {{uri}}"}],
     "gridPos": {"h": 9, "w": 12, "x": 0, "y": 0}},
    {"id": 2, "type": "timeseries", "title": "HTTP p95 latency", "datasource": {"uid": "prometheus"},
     "targets": [{"expr": "histogram_quantile(0.95, sum by (le, application) (rate(http_server_requests_seconds_bucket[5m])))", "legendFormat": "{{application}}"}],
     "gridPos": {"h": 9, "w": 12, "x": 12, "y": 0}},
    {"id": 3, "type": "timeseries", "title": "JVM heap used", "datasource": {"uid": "prometheus"},
     "targets": [{"expr": "sum by (application) (jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "{{application}}"}],
     "gridPos": {"h": 9, "w": 12, "x": 0, "y": 9}},
    {"id": 4, "type": "timeseries", "title": "Kafka listener rate", "datasource": {"uid": "prometheus"},
     "targets": [{"expr": "sum by (application) (rate(spring_kafka_listener_seconds_count[1m]))", "legendFormat": "{{application}}"}],
     "gridPos": {"h": 9, "w": 12, "x": 12, "y": 9}}
  ]
}
